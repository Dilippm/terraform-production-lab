# Terraform working directory
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*

# Terraform variable files containing environment-specific values
*.tfvars
*.tfvars.json

# Crash logs
crash.log
crash.*.log

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive or local configuration
.terraformrc
terraform.rc

# Environment variables
.env
.env.*

# Private keys
*.pem
*.key